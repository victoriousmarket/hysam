{
  "entities": {
    "User": {
      "title": "User Profile",
      "description": "User account information and roles",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "role": { "type": "string", "enum": ["admin", "staff"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "name", "email", "role"]
    },
    "Product": {
      "title": "Product",
      "description": "Product catalog item",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "category": { "type": "string" },
        "unitPrice": { "type": "number" },
        "currentStock": { "type": "number" },
        "minStockLevel": { "type": "number" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "unitPrice", "currentStock"]
    },
    "InventoryLog": {
      "title": "Inventory Log",
      "description": "History of stock movements",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "productId": { "type": "string" },
        "type": { "type": "string", "enum": ["stock-in", "stock-out"] },
        "quantity": { "type": "number" },
        "userId": { "type": "string" },
        "notes": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["productId", "type", "quantity", "userId", "timestamp"]
    },
    "Sale": {
      "title": "Sale Record",
      "description": "Sales transaction data",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "customerName": { "type": "string" },
        "totalAmount": { "type": "number" },
        "paidAmount": { "type": "number" },
        "status": { "type": "string", "enum": ["completed", "installment", "returned"] },
        "deliveryStatus": { "type": "string", "enum": ["none", "pending", "delivered"] },
        "userId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["customerName", "totalAmount", "status", "userId", "createdAt"]
    },
    "SaleItem": {
      "title": "Sale Item",
      "description": "Line items for a sale",
      "type": "object",
      "properties": {
        "productId": { "type": "string" },
        "productName": { "type": "string" },
        "quantity": { "type": "number" },
        "unitPrice": { "type": "number" },
        "totalPrice": { "type": "number" }
      },
      "required": ["productId", "quantity", "unitPrice", "totalPrice"]
    },
    "Payment": {
      "title": "Payment Record",
      "description": "Payment history for installments",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "saleId": { "type": "string" },
        "amount": { "type": "number" },
        "method": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" },
        "recordedBy": { "type": "string" }
      },
      "required": ["saleId", "amount", "timestamp", "recordedBy"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "Global user profiles"
    },
    "/products/{productId}": {
      "schema": "Product",
      "description": "Product inventory"
    },
    "/inventoryLogs/{logId}": {
      "schema": "InventoryLog",
      "description": "Audit trail for stock changes"
    },
    "/sales/{saleId}": {
      "schema": "Sale",
      "description": "Sales transactions"
    },
    "/sales/{saleId}/items/{itemId}": {
      "schema": "SaleItem",
      "description": "Items associated with a specific sale"
    },
    "/payments/{paymentId}": {
      "schema": "Payment",
      "description": "Installment payment history"
    }
  }
}
